# Step CA configuration
STEPCA_VERSION=0.30.2
DOCKER_STEPCA_INIT_NAME="HomeLab CA"
DOCKER_STEPCA_INIT_DNS_NAMES=ca.home.local,localhost,$(hostname -f)
DOCKER_STEPCA_INIT_REMOTE_MANAGEMENT=true
DOCKER_STEPCA_INIT_ACME=true

# Docker configuration
DOCKER_NETWORK=proxy
DOCKER_NETWORK_ALIAS=ca.home.local
DOCKER_CONTAINER_NAME=step-ca
DOCKER_CONTAINER_IP=192.168.200.254
DOCKER_VOLUME_NAME=step-ca-data

# Other configuration
ROOT_CA_CERT_PATH=/tmp/root_ca.crt